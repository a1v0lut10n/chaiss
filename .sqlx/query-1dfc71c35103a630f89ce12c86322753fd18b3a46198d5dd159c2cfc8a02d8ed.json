  "db_name": "SQLite",
  "query": "\n            SELECT \n                g.id, g.name, g.status, \n                pw.name as white_name, \n                pb.name as black_name\n            FROM games g\n            JOIN players pw ON g.white_player_id = pw.id\n            JOIN players pb ON g.black_player_id = pb.id\n            ORDER BY g.updated_at DESC\n            ",
