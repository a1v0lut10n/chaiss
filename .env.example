DATABASE_URL=sqlite:chaiss.db
# Default backend at launch: google | openai | anthropic | ollama.
# Every backend whose API key is set below appears in the chat pane's model
# dropdown; LLM_BACKEND picks which one starts selected.
LLM_BACKEND=google
# Optional: override a backend's default model
# (google: gemini-3.7-flash, openai: gpt-6-astra).
# LLM_MODEL applies to the LLM_BACKEND backend only; the per-backend forms
# take precedence over it.
# LLM_MODEL=gemini-3.1-pro-preview
# LLM_MODEL_GOOGLE=gemini-3.7-flash
# LLM_MODEL_OPENAI=gpt-6-astra
# LLM_MODEL_ANTHROPIC=claude-3-opus-20240229
# GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
GOOGLE_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
